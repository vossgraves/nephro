# Neon Postgres connection string (copy from Neon console, "Connect")
DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Server-side only — do not prefix any of these keys/models with NEXT_PUBLIC_.
# Configure one or both providers in Vercel Project Settings → Environment
# Variables. These are the ONLY variables the imaging API reads.

# OpenAI Vision adapter (server-side only)
OPENAI_API_KEY=
# Optional override; default model is gpt-5-mini. Must be a model ID the
# configured API accepts.
OPENAI_VISION_MODEL=gpt-5-mini
# Optional: set only for an OpenAI-compatible gateway, e.g.
# OPENAI_API_BASE=https://gateway.example.com/v1 ; omit for api.openai.com.
OPENAI_API_BASE=

# Gemini Vision adapter (server-side only)
GEMINI_API_KEY=
# Optional override; default model is gemini-2.5-flash. Must be a Gemini model ID.
GEMINI_VISION_MODEL=gemini-2.5-flash

# Rate limits (analyze 6/min, chat 20/min per IP) are fixed in code; there are
# no environment variables for them.
