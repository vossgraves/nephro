# Neon Postgres connection string (copy from Neon console, "Connect")
DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Server-side only — do not prefix these image-analysis keys with NEXT_PUBLIC_.
# Configure one or both in Vercel Project Settings → Environment Variables.

# OpenAI Vision adapter
OPENAI_API_KEY=
# Optional: defaults to gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
# Optional only for an OpenAI-compatible gateway; omit for api.openai.com.
OPENAI_API_BASE=

# Gemini Vision adapter
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
